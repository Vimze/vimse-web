---
interface Props {
  label?: string;
  title: string;
  subtitle?: string;
  centered?: boolean;
  dark?: boolean;
  titleSize?: string;
  class?: string;
}

const {
  label,
  title,
  subtitle,
  centered = false,
  dark = false,
  titleSize = "text-5xl",
  class: className = "",
} = Astro.props;
---

<div class:list={["section-label", { centered, dark }, className]}>
  {label && <span class="label">{label}</span>}
  <h2 class:list={["title", titleSize]}>
    <slot name="title">
      <Fragment set:html={title} />
    </slot>
  </h2>
  {subtitle && <p class="subtitle">{subtitle}</p>}
</div>

<style>
  .section-label {
    margin-bottom: 56px;
  }

  .section-label.centered {
    text-align: center;
  }

  .label {
    display: block;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary-500);
    margin-bottom: 12px;
  }

  .dark .label {
    color: var(--color-primary-300);
  }

  .title {
    font-family: var(--font-serif);
    font-weight: 700;
    color: var(--color-gray-900);
    line-height: 1.1;
    letter-spacing: -0.5px;
  }

  .title.text-5xl { font-size: 44px; }
  .title.text-6xl { font-size: 48px; }
  .title.text-7xl { font-size: 56px; }
  .title.text-4xl { font-size: 36px; }

  .dark .title {
    color: #fff;
  }

  .subtitle {
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-gray-500);
    margin-top: 16px;
  }

  .dark .subtitle {
    color: rgba(255, 255, 255, 0.5);
  }

  .centered .subtitle {
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
    margin-top: 16px;
  }

  @media (max-width: 767px) {
    .title.text-5xl { font-size: 32px; }
    .title.text-6xl { font-size: 36px; }
    .title.text-7xl { font-size: 38px; }
    .title.text-4xl { font-size: 28px; }
  }
</style>
