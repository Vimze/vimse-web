---
import { Image } from "astro:assets";

interface Props {
  imageSrc: ImageMetadata;
  alt: string;
  class?: string;
}

const { imageSrc, alt, class: className = "" } = Astro.props;
---

<div class:list={["phone-mockup", className]} role="img" aria-label={alt}>
  <div class="phone-bezel">
    <div class="phone-notch"></div>
    <div class="phone-screen">
      <Image
        src={imageSrc}
        alt={alt}
        width={560}
        height={1212}
        class="phone-screenshot"
      />
    </div>
  </div>
</div>

<style>
  .phone-mockup {
    width: 280px;
    flex-shrink: 0;
  }

  .phone-bezel {
    position: relative;
    width: 280px;
    height: 572px;
    background: #1a1a1a;
    border-radius: 44px;
    padding: 12px;
    box-shadow: var(--shadow-phone);
    overflow: hidden;
  }

  .phone-notch {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 28px;
    background: #1a1a1a;
    border-radius: 0 0 20px 20px;
    z-index: 2;
  }

  .phone-screen {
    width: 100%;
    height: 100%;
    border-radius: 34px;
    overflow: hidden;
    background: #f8f8f8;
  }

  .phone-screenshot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
</style>
