---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Reset password — Vimse"
  description="Choose a new password for your Vimse account."
  noindex
>
  <section class="reset-hero">
    <div class="container reset-container">
      <div class="reset-card">
        <span class="reset-label">Vimse account</span>

        <div data-state="verifying">
          <h1 class="reset-title">Checking your link…</h1>
        </div>

        <div data-state="form" hidden>
          <h1 class="reset-title">Choose a new password</h1>
          <form id="reset-form" class="reset-form">
            <label class="reset-field">
              <span>New password</span>
              <input type="password" name="password" autocomplete="new-password" minlength="6" required />
            </label>
            <label class="reset-field">
              <span>Confirm password</span>
              <input type="password" name="confirm" autocomplete="new-password" minlength="6" required />
            </label>
            <p id="reset-form-error" class="reset-error" role="alert" hidden></p>
            <button type="submit" class="reset-btn">Update password</button>
          </form>
        </div>

        <div data-state="success" hidden>
          <h1 class="reset-title">Password updated</h1>
          <p class="reset-body">Open the Vimse app and log in with your new password.</p>
        </div>

        <div data-state="error" hidden>
          <h1 class="reset-title">This link doesn't work</h1>
          <p class="reset-body">
            The link is invalid or has expired. Request a new one from "Forgotten password" in the Vimse app.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { createClient } from "@supabase/supabase-js";

  type State = "verifying" | "form" | "success" | "error";

  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  if (!supabaseUrl || !supabaseKey) {
    throw new Error("PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY must be set");
  }

  const supabase = createClient(supabaseUrl, supabaseKey, {
    auth: { persistSession: false, detectSessionInUrl: false },
  });

  const form = document.querySelector<HTMLFormElement>("#reset-form")!;
  const formError = document.querySelector<HTMLParagraphElement>("#reset-form-error")!;
  const submitButton = form.querySelector<HTMLButtonElement>("button[type=submit]")!;

  function show(state: State) {
    document.querySelectorAll<HTMLElement>("[data-state]").forEach((el) => {
      el.hidden = el.dataset.state !== state;
    });
  }

  function showFormError(message: string) {
    formError.textContent = message;
    formError.hidden = false;
  }

  async function verifyLink() {
    const params = new URLSearchParams(window.location.search);
    const tokenHash = params.get("token_hash");
    // Token is single-use; keep it out of history and referrers.
    history.replaceState(null, "", window.location.pathname);

    if (!tokenHash || params.get("type") !== "recovery") {
      show("error");
      return;
    }

    const { error } = await supabase.auth.verifyOtp({ token_hash: tokenHash, type: "recovery" });
    if (error) {
      console.error(error);
      show("error");
      return;
    }
    show("form");
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    formError.hidden = true;

    const data = new FormData(form);
    const password = String(data.get("password"));
    if (password !== String(data.get("confirm"))) {
      showFormError("The passwords don't match.");
      return;
    }

    submitButton.disabled = true;
    const { error } = await supabase.auth.updateUser({ password });
    submitButton.disabled = false;
    if (error) {
      showFormError(error.message);
      return;
    }

    await supabase.auth.signOut();
    show("success");
  });

  verifyLink();
</script>

<style>
  .reset-hero {
    background: var(--color-vimse-hero);
    min-height: 100vh;
    padding: 140px 0 80px;
    background-image:
      radial-gradient(ellipse 60% 50% at 30% 50%, rgba(0, 122, 110, 0.06) 0%, transparent 70%);
  }

  .reset-container {
    max-width: 520px;
  }

  .reset-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 28px;
    padding: 48px;
  }

  .reset-label {
    display: block;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary-300);
    margin-bottom: 12px;
  }

  .reset-title {
    font-family: var(--font-serif);
    font-size: 36px;
    color: #fff;
    line-height: 1.15;
    margin-bottom: 16px;
  }

  .reset-body {
    font-size: 16px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.5);
  }

  .reset-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 12px;
  }

  .reset-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.7);
  }

  .reset-field input {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 14px 16px;
    font-size: 16px;
    color: #fff;
  }

  .reset-field input:focus {
    outline: none;
    border-color: var(--color-primary-400);
  }

  .reset-error {
    font-size: 14px;
    color: var(--color-error);
  }

  .reset-btn {
    background: var(--color-primary-500);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    padding: 16px 32px;
    border-radius: 14px;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 122, 110, 0.25);
    transition: background 0.15s;
  }

  .reset-btn:hover {
    background: var(--color-primary-700);
  }

  .reset-btn:disabled {
    opacity: 0.6;
    cursor: default;
  }

  @media (max-width: 767px) {
    .reset-hero {
      padding: 120px 0 60px;
    }

    .reset-card {
      padding: 32px;
    }

    .reset-title {
      font-size: 28px;
    }
  }
</style>
